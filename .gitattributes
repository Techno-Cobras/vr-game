# Текстовые файлы хранятся с LF независимо от ОС разработчика.
* text=auto
*.cs text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.inputactions text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.ps1 text eol=lf

